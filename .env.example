# Discord Bot Credentials
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# User Authorization
OWNER_ID=123456789012345678
TRUSTED_USER_IDS=234567890123456789,345678901234567890

# Optional: Moderation Audit Log Channel ID where tool actions will be posted
MOD_LOG_CHANNEL_ID=987654321098765432

# Model routing (defaults shown)
CHAT_MODEL=gemini-3.6-flash
FAST_MODEL=gemini-3.5-flash-lite

# Optional: guild allowlist (comma-separated IDs; empty = allow all servers)
ALLOWED_GUILD_IDS=

# Optional: Bypass cooldown for specific users (comma-separated IDs; default is owner-friendly)
COOLDOWN_BYPASS_IDS=1463495220124454955

# Optional: AI watch mode (flags suspicious messages in a log channel; never auto-punishes)
WATCH_MODE=false
WATCH_LOG_CHANNEL_ID=

# Supabase Managed PostgreSQL Database & API
SUPABASE_URL=https://your_project_ref.supabase.co
SUPABASE_ACCESS_TOKEN=your_supabase_token
DATABASE_URL=postgresql://postgres:your_password@db.your_project_ref.supabase.co:5432/postgres
